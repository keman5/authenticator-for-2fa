{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "node",
      "chrome",
      "vitest"
    ],
    "allowJs": false,
    "checkJs": false,
    "noEmit": true,
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "src/**/*.d.ts",
    "src/lib/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx"
  ]
}
